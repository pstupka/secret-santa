{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "Secret Santa API",
    "description": "API for organizing Secret Santa gift exchanges",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "basePath": "/",
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "healthcheck"
        ],
        "summary": "Application service health check 💗",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/events": {
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Create an event (public). Emails the organizer their personal link.",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NewEvent"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/Event"
            }
          },
          "400": {
            "description": "Invalid input",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "429": {
            "description": "Rate limit exceeded (5/hour per IP, 3/hour per organizer email)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Events the person participates in (any status), with their own participant, soonest exchange date first",
        "security": [
          {
            "magicToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/MyEvent"
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/api/events/{eventId}": {
      "parameters": [
        {
          "in": "path",
          "name": "eventId",
          "required": true,
          "type": "string"
        }
      ],
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Event details with participant names and statuses (participant). The first view records firstOpenedAt.",
        "security": [
          {
            "magicToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/EventDetails"
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Unknown event, or the person is not a participant",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "patch": {
        "tags": [
          "events"
        ],
        "summary": "Edit details and dates (organizer). Only the given fields change.",
        "security": [
          {
            "magicToken": []
          }
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EventUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Event"
            }
          },
          "400": {
            "description": "Invalid input",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "The person is a participant but not the organizer",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Unknown event, or the person is not a participant",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "The event is finished (read-only)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "delete": {
        "tags": [
          "events"
        ],
        "summary": "Delete the event and all its data (organizer)",
        "security": [
          {
            "magicToken": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "The person is a participant but not the organizer",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Unknown event, or the person is not a participant",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "The event is finished (read-only)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/api/access-links": {
      "post": {
        "tags": [
          "access"
        ],
        "summary": "Email an additional personal link if the email is known. Always 202.",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "email"
              ],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                }
              }
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted (same response for unknown emails)",
            "schema": {
              "$ref": "#/definitions/ResponseWithMessage"
            }
          },
          "400": {
            "description": "Invalid input",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "429": {
            "description": "Rate limit exceeded (5/hour per IP, 3/hour per email)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "access"
        ],
        "summary": "The person identified by the magic token",
        "security": [
          {
            "magicToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Person"
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/api/events/{eventId}/participants": {
      "parameters": [
        {
          "in": "path",
          "name": "eventId",
          "required": true,
          "type": "string"
        }
      ],
      "get": {
        "tags": [
          "participants"
        ],
        "summary": "List participants (participant). Everyone sees names and statuses; the organizer also sees emails, invitation state, caretakers and wishlist flags.",
        "security": [
          {
            "magicToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "ParticipantSummary items, or OrganizerParticipant items for the organizer",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/OrganizerParticipant"
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Unknown event, or the person is not a participant",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "post": {
        "tags": [
          "participants"
        ],
        "summary": "Add a participant silently, no email (organizer, open events). At most 50 participants.",
        "security": [
          {
            "magicToken": []
          }
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NewParticipant"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/OrganizerParticipant"
            }
          },
          "400": {
            "description": "Invalid input, or the caretaker is not a non-managed participant of this event",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "The person is a participant but not the organizer",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Unknown event, or the person is not a participant",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "The event is drawn or finished, the person is already a participant, or the event has 50 participants",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/api/events/{eventId}/participants/{participantId}": {
      "parameters": [
        {
          "in": "path",
          "name": "eventId",
          "required": true,
          "type": "string"
        },
        {
          "in": "path",
          "name": "participantId",
          "required": true,
          "type": "string"
        }
      ],
      "delete": {
        "tags": [
          "participants"
        ],
        "summary": "Remove a participant with their wishlists and exclusions (organizer, open events)",
        "security": [
          {
            "magicToken": []
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "The person is a participant but not the organizer",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Unknown event or participant, or the person is not a participant",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "The event is drawn or finished, the participant is the organizer, or a caretaker who still has managed participants",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/api/events/{eventId}/participants/{participantId}/invitation": {
      "parameters": [
        {
          "in": "path",
          "name": "eventId",
          "required": true,
          "type": "string"
        },
        {
          "in": "path",
          "name": "participantId",
          "required": true,
          "type": "string"
        }
      ],
      "post": {
        "tags": [
          "invitations"
        ],
        "summary": "Send or resend the invitation to one participant with a new personal link (organizer, open events)",
        "security": [
          {
            "magicToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Invitation queued",
            "schema": {
              "$ref": "#/definitions/InvitationSent"
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "The person is a participant but not the organizer",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Unknown event or participant, or the person is not a participant",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "The event is drawn or finished",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "422": {
            "description": "The participant is a managed participant, who never receives emails",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/api/events/{eventId}/invitations/send": {
      "parameters": [
        {
          "in": "path",
          "name": "eventId",
          "required": true,
          "type": "string"
        }
      ],
      "post": {
        "tags": [
          "invitations"
        ],
        "summary": "Send invitations to every non-managed participant not invited yet (organizer, open events). Never re-sends.",
        "security": [
          {
            "magicToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Number of invitations queued",
            "schema": {
              "type": "object",
              "required": [
                "sent"
              ],
              "properties": {
                "sent": {
                  "type": "integer",
                  "example": 2
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "The person is a participant but not the organizer",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Unknown event, or the person is not a participant",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "The event is drawn or finished",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/api/events/{eventId}/participation/decline": {
      "parameters": [
        {
          "in": "path",
          "name": "eventId",
          "required": true,
          "type": "string"
        }
      ],
      "post": {
        "tags": [
          "participants"
        ],
        "summary": "Decline: leave the draw (open events). A caretaker may act for a managed participant with X-Acting-As.",
        "security": [
          {
            "magicToken": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Acting-As",
            "required": false,
            "type": "string",
            "description": "Participant id of a managed participant to act as; only their caretaker may"
          }
        ],
        "responses": {
          "200": {
            "description": "The participant with the new status",
            "schema": {
              "$ref": "#/definitions/ParticipantSummary"
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "X-Acting-As names a participant the caller is not the caretaker of",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Unknown event, or the person is not a participant",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "The event is drawn or finished, or the organizer tries to decline",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/api/events/{eventId}/participation/rejoin": {
      "parameters": [
        {
          "in": "path",
          "name": "eventId",
          "required": true,
          "type": "string"
        }
      ],
      "post": {
        "tags": [
          "participants"
        ],
        "summary": "Rejoin: undo a decline (open events). A caretaker may act for a managed participant with X-Acting-As.",
        "security": [
          {
            "magicToken": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Acting-As",
            "required": false,
            "type": "string",
            "description": "Participant id of a managed participant to act as; only their caretaker may"
          }
        ],
        "responses": {
          "200": {
            "description": "The participant with the new status",
            "schema": {
              "$ref": "#/definitions/ParticipantSummary"
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "X-Acting-As names a participant the caller is not the caretaker of",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Unknown event, or the person is not a participant",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "The event is drawn or finished",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ResponseWithMessage": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      }
    },
    "Person": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "NewEvent": {
      "type": "object",
      "required": [
        "title",
        "timezone",
        "exchangeOn",
        "organizerName",
        "organizerEmail"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 5000,
          "x-nullable": true
        },
        "budgetAmount": {
          "type": "integer",
          "minimum": 0,
          "description": "Minor units, e.g. 15000 = 150.00 PLN; requires budgetCurrency"
        },
        "budgetCurrency": {
          "type": "string",
          "example": "PLN",
          "description": "ISO 4217; requires budgetAmount"
        },
        "rules": {
          "type": "string",
          "maxLength": 5000,
          "x-nullable": true
        },
        "timezone": {
          "type": "string",
          "example": "Europe/Warsaw"
        },
        "exchangeOn": {
          "type": "string",
          "format": "date",
          "example": "2026-12-24",
          "description": "Not in the past in the event timezone"
        },
        "organizerName": {
          "type": "string",
          "maxLength": 100
        },
        "organizerEmail": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "Event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "x-nullable": true
        },
        "budgetAmount": {
          "type": "integer",
          "x-nullable": true
        },
        "budgetCurrency": {
          "type": "string",
          "x-nullable": true
        },
        "rules": {
          "type": "string",
          "x-nullable": true
        },
        "timezone": {
          "type": "string"
        },
        "exchangeOn": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "drawn",
            "finished"
          ]
        },
        "drawnAt": {
          "type": "string",
          "format": "date-time",
          "x-nullable": true
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "EventUpdate": {
      "type": "object",
      "minProperties": 1,
      "description": "Partial update: absent fields are unchanged; null or blank text clears description/rules; budgetAmount and budgetCurrency are set or cleared (null) together",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 5000,
          "x-nullable": true
        },
        "budgetAmount": {
          "type": "integer",
          "minimum": 0,
          "x-nullable": true,
          "description": "Minor units; requires budgetCurrency"
        },
        "budgetCurrency": {
          "type": "string",
          "example": "PLN",
          "x-nullable": true,
          "description": "ISO 4217; requires budgetAmount"
        },
        "rules": {
          "type": "string",
          "maxLength": 5000,
          "x-nullable": true
        },
        "timezone": {
          "type": "string",
          "example": "Europe/Warsaw"
        },
        "exchangeOn": {
          "type": "string",
          "format": "date",
          "description": "Not in the past in the (new) event timezone"
        }
      }
    },
    "MyParticipant": {
      "type": "object",
      "description": "The caller's own participant in the event",
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "organizer",
            "member"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "declined"
          ]
        }
      }
    },
    "MyEvent": {
      "allOf": [
        {
          "$ref": "#/definitions/Event"
        },
        {
          "type": "object",
          "properties": {
            "myParticipant": {
              "$ref": "#/definitions/MyParticipant"
            }
          }
        }
      ]
    },
    "ParticipantSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "organizer",
            "member"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "declined"
          ]
        }
      }
    },
    "EventDetails": {
      "allOf": [
        {
          "$ref": "#/definitions/MyEvent"
        },
        {
          "type": "object",
          "properties": {
            "participants": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ParticipantSummary"
              }
            },
            "managedParticipants": {
              "type": "array",
              "description": "The caller's managed participants, whom they can act as with X-Acting-As",
              "items": {
                "$ref": "#/definitions/ParticipantSummary"
              }
            }
          }
        }
      ]
    },
    "NewParticipant": {
      "type": "object",
      "required": [
        "displayName"
      ],
      "description": "Exactly one of email (a participant with a person) or managedByParticipantId (a managed participant)",
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Finds or creates the person"
        },
        "managedByParticipantId": {
          "type": "string",
          "description": "Caretaker: a non-managed participant of the same event"
        }
      }
    },
    "OrganizerParticipant": {
      "allOf": [
        {
          "$ref": "#/definitions/ParticipantSummary"
        },
        {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "x-nullable": true,
              "description": "null for a managed participant"
            },
            "managedByParticipantId": {
              "type": "string",
              "x-nullable": true,
              "description": "Caretaker of a managed participant"
            },
            "inviteSentAt": {
              "type": "string",
              "format": "date-time",
              "x-nullable": true
            },
            "firstOpenedAt": {
              "type": "string",
              "format": "date-time",
              "x-nullable": true,
              "description": "First authenticated GET of the event"
            },
            "wishlistFilled": {
              "type": "boolean",
              "description": "The participant's own wishlist has items or notes"
            }
          }
        }
      ]
    },
    "InvitationSent": {
      "type": "object",
      "required": [
        "participantId",
        "inviteSentAt"
      ],
      "properties": {
        "participantId": {
          "type": "string"
        },
        "inviteSentAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "securityDefinitions": {
    "magicToken": {
      "type": "apiKey",
      "in": "header",
