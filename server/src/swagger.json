{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "Secret Santa API",
    "description": "API for organizing Secret Santa gift exchanges",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "basePath": "/",
  "schemes": [
    "http",
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "healthcheck"
        ],
        "summary": "Application service health check 💗",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/events": {
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Create an event (public). Emails the organizer their personal link.",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NewEvent"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/Event"
            }
          },
          "400": {
            "description": "Invalid input",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "429": {
            "description": "Rate limit exceeded (5/hour per IP, 3/hour per organizer email)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Events the person participates in (any status), with their own participant, soonest exchange date first",
        "security": [
          {
            "magicToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/MyEvent"
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/api/events/{eventId}": {
      "parameters": [
        {
          "in": "path",
          "name": "eventId",
          "required": true,
          "type": "string"
        }
      ],
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Event details with participant names and statuses (participant)",
        "security": [
          {
            "magicToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/EventDetails"
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Unknown event, or the person is not a participant",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "patch": {
        "tags": [
          "events"
        ],
        "summary": "Edit details and dates (organizer). Only the given fields change.",
        "security": [
          {
            "magicToken": []
          }
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/EventUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Event"
            }
          },
          "400": {
            "description": "Invalid input",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "The person is a participant but not the organizer",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Unknown event, or the person is not a participant",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "The event is finished (read-only)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "delete": {
        "tags": [
          "events"
        ],
        "summary": "Delete the event and all its data (organizer)",
        "security": [
          {
            "magicToken": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "The person is a participant but not the organizer",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Unknown event, or the person is not a participant",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "The event is finished (read-only)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/api/access-links": {
      "post": {
        "tags": [
          "access"
        ],
        "summary": "Email an additional personal link if the email is known. Always 202.",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "email"
              ],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                }
              }
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted (same response for unknown emails)",
            "schema": {
              "$ref": "#/definitions/ResponseWithMessage"
            }
          },
          "400": {
            "description": "Invalid input",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "429": {
            "description": "Rate limit exceeded (5/hour per IP, 3/hour per email)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "access"
        ],
        "summary": "The person identified by the magic token",
        "security": [
          {
            "magicToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Person"
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked magic token",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ResponseWithMessage": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      }
    },
    "Person": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "NewEvent": {
      "type": "object",
      "required": [
        "title",
        "timezone",
        "exchangeOn",
        "organizerName",
        "organizerEmail"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 5000,
          "x-nullable": true
        },
        "budgetAmount": {
          "type": "integer",
          "minimum": 0,
          "description": "Minor units, e.g. 15000 = 150.00 PLN; requires budgetCurrency"
        },
        "budgetCurrency": {
          "type": "string",
          "example": "PLN",
          "description": "ISO 4217; requires budgetAmount"
        },
        "rules": {
          "type": "string",
          "maxLength": 5000,
          "x-nullable": true
        },
        "timezone": {
          "type": "string",
          "example": "Europe/Warsaw"
        },
        "exchangeOn": {
          "type": "string",
          "format": "date",
          "example": "2026-12-24",
          "description": "Not in the past in the event timezone"
        },
        "organizerName": {
          "type": "string",
          "maxLength": 100
        },
        "organizerEmail": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "Event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "x-nullable": true
        },
        "budgetAmount": {
          "type": "integer",
          "x-nullable": true
        },
        "budgetCurrency": {
          "type": "string",
          "x-nullable": true
        },
        "rules": {
          "type": "string",
          "x-nullable": true
        },
        "timezone": {
          "type": "string"
        },
        "exchangeOn": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "drawn",
            "finished"
          ]
        },
        "drawnAt": {
          "type": "string",
          "format": "date-time",
          "x-nullable": true
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "EventUpdate": {
      "type": "object",
      "minProperties": 1,
      "description": "Partial update: absent fields are unchanged; null or blank text clears description/rules; budgetAmount and budgetCurrency are set or cleared (null) together",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 5000,
          "x-nullable": true
        },
        "budgetAmount": {
          "type": "integer",
          "minimum": 0,
          "x-nullable": true,
          "description": "Minor units; requires budgetCurrency"
        },
        "budgetCurrency": {
          "type": "string",
          "example": "PLN",
          "x-nullable": true,
          "description": "ISO 4217; requires budgetAmount"
        },
        "rules": {
          "type": "string",
          "maxLength": 5000,
          "x-nullable": true
        },
        "timezone": {
          "type": "string",
          "example": "Europe/Warsaw"
        },
        "exchangeOn": {
          "type": "string",
          "format": "date",
          "description": "Not in the past in the (new) event timezone"
        }
      }
    },
    "MyParticipant": {
      "type": "object",
      "description": "The caller's own participant in the event",
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "organizer",
            "member"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "declined"
          ]
        }
      }
    },
    "MyEvent": {
      "allOf": [
        {
          "$ref": "#/definitions/Event"
        },
        {
          "type": "object",
          "properties": {
            "myParticipant": {
              "$ref": "#/definitions/MyParticipant"
            }
          }
        }
      ]
    },
    "ParticipantSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "organizer",
            "member"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "declined"
          ]
        }
      }
    },
    "EventDetails": {
      "allOf": [
        {
          "$ref": "#/definitions/MyEvent"
        },
        {
          "type": "object",
          "properties": {
            "participants": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ParticipantSummary"
              }
            }
          }
        }
      ]
    }
  },
  "securityDefinitions": {
    "magicToken": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "`Bearer <magic token>` from a personal link"
    }
  }
}
