{
  "compilerOptions": {
    "target": "ESNext",
    "types": ["node"],
    "typeRoots": ["node_modules/@types", "../node_modules/@types", "typings"],
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "declaration": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "removeComments": false,
    "strict": true,
    "noImplicitAny": false,
    "allowJs": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@app": ["./src/app.ts"],
      "api": ["./src/api.ts"],
      "core/*": ["./src/core/*"],
      "@core/*": ["./src/core/*"],
      "@components/*": ["./src/components/*"],
      "@config/*": ["./src/config/*"],
      "@db/*": ["./src/db/*"],
      "@shared/*": ["./src/shared/*"],
      "@test/*": ["./src/test/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "test/**/*",
    "src/test/**/*",
    "ci/**/*",
    "scripts/**/*",
    "__mocks__/**/*",
    "**/node_modules/**/*",
    "**/dts/**/*",
    "**/dist/**/*",
    "**/*.spec.ts",
    "**/*.test.ts"
  ],
  "compileOnSave": true,
  "typeAcquisition": {
    "enable": true
  }
}