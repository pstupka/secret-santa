{
  "compilerOptions": {
    "target": "ESNext",
    "types": ["node"],
    "typeRoots": ["node_modules/@types", "../node_modules/@types", "typings"],
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "declaration": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "removeComments": false,
    "strict": true,
    "noImplicitAny": false,
    "allowJs": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "rootDir": ".",
    "noEmit": true,
    "paths": {
      "@app": ["./src/app.ts"],
      "api": ["./src/api.ts"],
      "core/*": ["./src/core/*"],
      "@core/*": ["./src/core/*"],
      "@components/*": ["./src/components/*"],
      "@config/*": ["./src/config/*"],
      "@db/*": ["./src/db/*"],
      "@email/*": ["./src/email/*"],
      "@shared/*": ["./src/shared/*"],
      "@test/*": ["./src/test/*"]
    }
  },
  "include": ["src/**/*", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"],
  "compileOnSave": true,
  "typeAcquisition": {
    "enable": true
  }
}