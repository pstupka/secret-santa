{
  "name": "secret-santa",
  "description": "A web service for organizing Secret Santa gift exchanges.",
  "private": true,
  "keywords": [
    "secret-santa",
    "gift-exchange",
    "holiday-gift-exchange",
    "monorepo"
  ],
  "workspaces": [
    "server",
    "client",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -k -n mail,server,client -c magenta,blue,green \"yarn mail:dev\" \"yarn server:dev\" \"yarn client:dev\"",
    "server:dev": "yarn workspace @secret-santa/server server:dev",
    "client:dev": "yarn workspace @secret-santa/client client:dev",
    "client:build": "yarn workspace @secret-santa/client build",
    "client:test": "yarn workspace @secret-santa/client test",
    "client:typecheck": "yarn workspace @secret-santa/client typecheck",
    "client:lint": "yarn workspace @secret-santa/client lint",
    "docker:server:dev": "docker compose -f server/docker-compose.yaml up --build",
    "e2e": "yarn workspace @secret-santa/e2e e2e",
    "e2e:install": "yarn workspace @secret-santa/e2e e2e:install",
    "mail:dev": "docker compose -f server/docker-compose.yaml up mailpit"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^6.0.3"
  }
}
