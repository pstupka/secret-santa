{
  "name": "@secret-santa/e2e",
  "description": "Playwright end-to-end tests against the production image and Mailpit.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier --check \"**/*.{ts,json,yaml}\"",
    "prettier:fix": "prettier --write \"**/*.{ts,json,yaml}\""
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "prettier": "^2.5.1",
    "typescript": "^6.0.3"
  }
}
