# Reverse proxy for the app, with automatic HTTPS (Let's Encrypt).
# The site address is PUBLIC_URL from .env, e.g. https://santa.example.com
# (no trailing slash); its DNS record must point at this host and ports 80
# and 443 must be reachable.
{$PUBLIC_URL} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy app:8080
}
