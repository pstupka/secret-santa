# Production settings for compose.prod.yaml. Copy to .env (never commit it).

# Public origin of the app, no trailing slash. Used for links in emails and as
# Caddy's site address (it gets an HTTPS certificate for this host name).
PUBLIC_URL=https://santa.example.com

# Outgoing email: smtps:// for implicit TLS (port 465), smtp:// for STARTTLS
# (port 587). URL-encode special characters in the user name and password.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Secret Santa <santa@example.com>
